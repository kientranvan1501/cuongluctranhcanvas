<a class="product-card" href="/san-pham/<%= p.slug %>">
  <div class="pc-img">
    <img src="<%= p.card %>"<% if (p.cardSrcset) { %> srcset="<%= p.cardSrcset %>" sizes="(max-width: 720px) 50vw, (max-width: 1024px) 33vw, 310px"<% } %> alt="<%= p.name %>" loading="lazy" decoding="async" width="800" height="800">
    <% if (p.compare_price) { %><span class="badge">-<%= Math.round(100 - p.min_price*100/p.compare_price) %>%</span><% } %>
  </div>
  <div class="pc-body">
    <h3><%= p.name %><% if (p.code) { %> - <%= p.code %><% } %></h3>
    <div class="price">
      <%= p.has_range ? 'Từ ' : '' %><% if (p.compare_price) { %><span class="sale"><%= formatPrice(p.min_price) %></span> <del><%= formatPrice(p.compare_price) %></del><% } else { %><%= formatPrice(p.min_price) %><% } %>
    </div>
  </div>
</a>
