</main>
<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <h4><%= settings.company_name %></h4>
      <% if (settings.company_info) { %><p><%= settings.company_info %></p><% } %>
      <% if (settings.hotline) { %><p>Hotline: <a href="tel:<%= (settings.hotline||'').replace(/\D/g,'') %>"><%= settings.hotline %></a></p><% } %>
      <% const _zf = (settings.zalo || '').trim(); if (_zf && _zf !== '#') { %><p>Zalo: <a href="<%= /^https?:\/\//.test(_zf) ? _zf : 'https://zalo.me/' + _zf.replace(/\D/g, '') %>" target="_blank" rel="noopener nofollow"><%= /^https?:\/\//.test(_zf) ? 'Chat Zalo' : _zf.replace(/\D/g, '').replace(/^(\d{4})(\d{3})(\d+)$/, '$1 $2 $3') %></a></p><% } %>
      <% if (settings.email) { %><p>Email: <a href="mailto:<%= settings.email %>"><%= settings.email %></a></p><% } %>
      <% if (settings.address) { %><p>Địa chỉ: <%= settings.address %></p><% } %>
    </div>
    <div>
      <h4>Về <%= settings.site_name %></h4>
      <p><%= settings.about %></p>
    </div>
    <div>
      <h4>Sản Phẩm</h4>
      <ul><% menu.forEach(function(c){ %><li><a href="/danh-muc/<%= c.slug %>"><%= c.name %></a></li><% }) %></ul>
    </div>
    <div>
      <h4>Các Chính Sách</h4>
      <ul><% footerPages.forEach(function(p){ %><li><a href="/trang/<%= p.slug %>"><%= p.title %></a></li><% }) %></ul>
      <div class="socials">
        <%# Chỉ hiện mạng xã hội đã điền link thật (bỏ trống hoặc "#" thì ẩn) %>
        <% [['facebook', 'Facebook'], ['instagram', 'Instagram'], ['youtube', 'YouTube']].forEach(function (s) { if (/^https?:\/\//.test(settings[s[0]] || '')) { %><a href="<%= settings[s[0]] %>" target="_blank" rel="noopener"><%= s[1] %></a><% } }) %>
      </div>
    </div>
  </div>
  <div class="copyright">© <%= new Date().getFullYear() %>, <%= settings.site_name %></div>
</footer>

<%# Nút liên hệ nổi: thêm / sửa / xóa ở Quản trị → Nút liên hệ %>
<% if (typeof contactButtons !== 'undefined' && contactButtons.length) { %>
<div class="float-btns pos-<%= settings.cb_position || 'bottom-right' %>">
  <% contactButtons.forEach(function (b, i) { %>
  <a class="fb-btn fx-<%= b.effect %> show-<%= b.show_on %><%= b.icon_full ? ' icon-full' : '' %>" href="<%= b.link %>" style="--bg: <%= b.color || '#2196f3' %>; --d: <%= i %>"
     <% if (b.new_tab) { %>target="_blank" rel="noopener nofollow"<% } %> aria-label="<%= b.label %>" title="<%= b.label %>">
    <% if (b.icon) { %><img src="<%= b.icon %>" alt="" width="56" height="56"><% } else { %><span class="fb-txt"><%= b.label.slice(0, 2) %></span><% } %>
  </a>
  <% }) %>
</div>
<% } %>

<script src="<%= asset('/js/main.js') %>"></script>
<%- settings.footer_code || '' %>
</body>
</html>
