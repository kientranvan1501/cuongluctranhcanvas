<%- include('partials/header') %>
<div class="container page-wrap">
  <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Trang chủ</a> /
    <% trail.slice(0, -1).forEach(function (c) { %><a href="/danh-muc/<%= c.slug %>"><%= c.name %></a> / <% }) %>
    <span aria-current="page"><%= heading %></span></nav>
  <h1 class="page-title"><%= heading %></h1>
  <% if (subcats.length) { %>
    <div class="chips"><% subcats.forEach(function(s){ %><a href="/danh-muc/<%= s.slug %>"><%= s.name %></a><% }) %></div>
  <% } %>
  <div class="toolbar">
    <span><%= total %> sản phẩm</span>
    <form>
      <% if (q) { %><input type="hidden" name="q" value="<%= q %>"><% } %>
      <select name="sort" onchange="this.form.submit()">
        <option value="new" <%= sort==='new'?'selected':'' %>>Mới nhất</option>
        <option value="price_asc" <%= sort==='price_asc'?'selected':'' %>>Giá tăng dần</option>
        <option value="price_desc" <%= sort==='price_desc'?'selected':'' %>>Giá giảm dần</option>
        <option value="name" <%= sort==='name'?'selected':'' %>>Tên A-Z</option>
      </select>
    </form>
  </div>
  <% if (products.length) { %>
    <div class="product-grid"><% products.forEach(function(p){ %><%- include('partials/product-card', { p: p }) %><% }) %></div>
  <% } else { %><p class="empty">Chưa có sản phẩm.</p><% } %>
  <% if (pages > 1) { %>
    <div class="pagination">
      <% for (let i = 1; i <= pages; i++) { %>
        <%# Link phân trang sạch: trang 1 không có ?page, chỉ thêm sort khi khác mặc định %>
        <% const _qs = [q ? 'q=' + encodeURIComponent(q) : '', sort !== 'new' ? 'sort=' + sort : '', i > 1 ? 'page=' + i : ''].filter(Boolean).join('&'); %>
        <a class="<%= i===page?'active':'' %>" href="<%= currentPath %><%= _qs ? '?' + _qs : '' %>" <%- i===page ? 'aria-current="page"' : '' %>><%= i %></a>
      <% } %>
    </div>
  <% } %>
  <% if (description) { %><div class="cat-desc rich"><%- richText(description) %></div><% } %>
</div>
<%- include('partials/footer') %>
