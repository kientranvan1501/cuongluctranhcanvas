<%- include('partials/header') %>
<div class="container page-wrap">
  <h1 class="page-title">Gallery</h1>
  <% if (!photos.length) { %>
    <p class="muted" style="text-align:center;padding:40px 0">Ảnh khách hàng đang được cập nhật.</p>
  <% } else { %>
  <%# Lưới ảnh kiểu "masonry" giữ đúng tỉ lệ ảnh; bấm ảnh để xem lớn (main.js) %>
  <div class="gallery-grid" id="galleryGrid">
    <% photos.forEach(function (p, i) { %>
      <a class="gallery-item" href="<%= p.image %>" data-caption="<%= p.caption %>">
        <img src="<%= p.thumb || p.image %>" alt="<%= p.caption || ('Ảnh khách hàng ' + settings.site_name + ' ' + ((page - 1) * 48 + i + 1)) %>"
          <% if (p.width && p.height) { %>width="700" height="<%= Math.round(700 * p.height / p.width) %>"<% } %>
          loading="<%= i < 8 ? 'eager' : 'lazy' %>" decoding="async">
      </a>
    <% }) %>
  </div>
  <% if (pages > 1) { %>
    <div class="pagination">
      <% for (let i = 1; i <= pages; i++) { %>
        <a class="<%= i === page ? 'active' : '' %>" href="/gallery<%= i > 1 ? '?page=' + i : '' %>" <%- i === page ? 'aria-current="page"' : '' %>><%= i %></a>
      <% } %>
    </div>
  <% } %>
  <% } %>
</div>

<dialog class="gallery-box" id="galleryBox" aria-label="Xem ảnh">
  <button type="button" class="gb-close" aria-label="Đóng">×</button>
  <button type="button" class="gb-nav gb-prev" aria-label="Ảnh trước">‹</button>
  <figure><img id="gbImg" alt=""><figcaption id="gbCap"></figcaption></figure>
  <button type="button" class="gb-nav gb-next" aria-label="Ảnh sau">›</button>
  <span class="gb-count" id="gbCount"></span>
</dialog>
<%- include('partials/footer') %>
