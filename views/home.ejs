<%- include('partials/header') %>

<%# Banner dùng thẻ <img> thật (có alt, ưu tiên tải) thay cho ảnh nền CSS: tốt cho SEO & tốc độ LCP %>
<% const heroStyle = '--hero-h: ' + (parseInt(settings.hero_height) || 78) + 'vh; --ov: ' + (parseInt(settings.hero_overlay) >= 0 ? parseInt(settings.hero_overlay) : 55) / 100; %>
<% if (heroSlides.length) { %>
<%# Slider: slide 1 tải ưu tiên + có h1 (mỗi trang 1 h1), các slide sau tải lười, tiêu đề dùng h2 %>
<section class="hero hero-slider" style="<%= heroStyle %>" data-interval="<%= (parseInt(settings.hero_interval) || 5) * 1000 %>" aria-roledescription="carousel" aria-label="Banner">
  <% heroSlides.forEach(function (sl, i) { const first = i === 0; %>
  <div class="hero-slide<%= first ? ' is-active' : '' %>" role="group" aria-roledescription="slide" aria-label="<%= i + 1 %> / <%= heroSlides.length %>"<%= first ? '' : ' aria-hidden=true' %>>
    <picture>
      <% if (sl.image_mobile) { %><source media="(max-width: 720px)" srcset="<%= sl.image_mobile %>"><% } %>
      <img class="hero-img" src="<%= sl.image %>" alt="<%= sl.alt || sl.title || settings.site_name %>" <%- first ? 'fetchpriority="high"' : 'loading="lazy"' %> decoding="async">
    </picture>
    <div class="hero-overlay">
      <% if (first) { %><h1><%= sl.title || settings.hero_title || settings.site_name %></h1><% } else if (sl.title) { %><h2 class="hero-title"><%= sl.title %></h2><% } %>
      <% if (sl.subtitle) { %><p><%= sl.subtitle %></p><% } %>
      <% if (sl.button) { %><a class="btn btn-light" href="<%= sl.link || '/shop' %>"<%- first ? '' : ' tabindex="-1"' %>><%= sl.button %></a><% } %>
    </div>
  </div>
  <% }) %>
  <% if (heroSlides.length > 1) { %>
  <button class="hero-nav prev" aria-label="Slide trước">‹</button>
  <button class="hero-nav next" aria-label="Slide sau">›</button>
  <div class="hero-dots"><% heroSlides.forEach(function (sl, i) { %><button aria-label="Xem slide <%= i + 1 %>"<%- i === 0 ? ' aria-current="true"' : '' %>></button><% }) %></div>
  <% } %>
</section>
<% } else { %>
<section class="hero" style="<%= heroStyle %>">
  <% if (settings.hero_image) { %>
  <picture>
    <% if (settings.hero_image_mobile) { %><source media="(max-width: 720px)" srcset="<%= settings.hero_image_mobile %>"><% } %>
    <img class="hero-img" src="<%= settings.hero_image %>" alt="<%= settings.hero_alt || settings.hero_title || settings.site_name %>" fetchpriority="high" decoding="async">
  </picture>
  <% } %>
  <div class="hero-overlay">
    <h1><%= settings.hero_title || settings.site_name %></h1>
    <% if (settings.hero_subtitle) { %><p><%= settings.hero_subtitle %></p><% } %>
    <% if (settings.hero_button) { %><a class="btn btn-light" href="<%= settings.hero_link || '/shop' %>"><%= settings.hero_button %></a><% } %>
  </div>
</section>
<% } %>

<%
const sections = [
  { title: 'Sản Phẩm Nổi Bật', list: featured, link: '/best-sellers' },
  { title: 'BST Tranh Mới', list: newest, link: '/bst-moi' },
  { cats: true },
];
if (sonDau) sections.push({ title: sonDau.name, list: sonDauProducts, link: '/danh-muc/' + sonDau.slug });
%>

<% sections.forEach(function(s){ %>
  <% if (s.cats && homeCats.length) { %>
  <section class="section container">
    <div class="section-head"><h2>Bộ Sưu Tập</h2><a href="/collections">Xem thêm →</a></div>
    <div class="carousel">
      <button class="car-btn prev" aria-label="Trước">‹</button>
      <div class="car-track">
        <% homeCats.forEach(function(c){ %>
          <a class="cat-tile" href="/danh-muc/<%= c.slug %>"><img src="<%= c.image || '/img/no-image.svg' %>" alt="<%= c.name %>" loading="lazy"><span><%= c.name %></span></a>
        <% }) %>
      </div>
      <button class="car-btn next" aria-label="Sau">›</button>
    </div>
  </section>
  <% } else if (s.list && s.list.length) { %>
  <section class="section container">
    <div class="section-head"><h2><%= s.title %></h2><a href="<%= s.link %>">Xem thêm →</a></div>
    <div class="carousel">
      <button class="car-btn prev" aria-label="Trước">‹</button>
      <div class="car-track"><% s.list.forEach(function(p){ %><%- include('partials/product-card', { p: p }) %><% }) %></div>
      <button class="car-btn next" aria-label="Sau">›</button>
    </div>
  </section>
  <% } %>
<% }) %>

<section class="values">
  <div class="container values-grid">
    <div><span class="v-ico">◆</span><h3>Đa Dạng</h3><p>Hơn 20.000 mẫu thiết kế đa dạng chủ đề, phong cách.</p></div>
    <div><span class="v-ico">★</span><h3>Chất Lượng</h3><p>Cam kết chất lượng, đổi trả nếu không hài lòng.</p></div>
    <div><span class="v-ico">✔</span><h3>Uy Tín</h3><p>Hàng trăm nghìn khách hàng tin tưởng lựa chọn.</p></div>
    <div><span class="v-ico">➤</span><h3>Tốc Độ</h3><p>Hỗ trợ lắp đặt miễn phí tận nhà trong 24h.</p></div>
  </div>
</section>

<% if (settings.video_url) { %>
<section class="section container video-wrap">
  <iframe src="<%= settings.video_url.replace('watch?v=', 'embed/').replace('youtu.be/', 'www.youtube.com/embed/') %>" loading="lazy" allowfullscreen title="Video"></iframe>
</section>
<% } %>

<section class="cta">
  <h2>Bạn cần tìm mẫu thiết kế ưng ý hơn?</h2>
  <a class="btn btn-light" href="/shop">Xem Tất Cả Bộ Tranh</a>
</section>

<%- include('partials/footer') %>
