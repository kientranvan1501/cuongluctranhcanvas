<%- include('_head') %>
<form method="post" enctype="multipart/form-data" class="form-grid">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <div class="col-main">
    <div class="card">
      <h3>Thông tin chung</h3>
      <div class="row">
        <label>Tên website<input name="site_name" value="<%= settings.site_name %>"></label>
        <label>Hotline<input name="hotline" value="<%= settings.hotline %>"></label>
      </div>
      <div class="row">
        <label>Email<input name="email" value="<%= settings.email %>"></label>
        <label>Số Zalo (nút chat nổi, để trống để ẩn)<input name="zalo" value="<%= settings.zalo %>"></label>
      </div>
      <label>Địa chỉ showroom<input name="address" value="<%= settings.address %>"></label>
      <div class="row">
        <label>Tên công ty<input name="company_name" value="<%= settings.company_name %>"></label>
        <label>Thông tin GPKD<input name="company_info" value="<%= settings.company_info %>"></label>
      </div>
      <label>Giới thiệu ngắn (footer)<textarea name="about" rows="3"><%= settings.about %></textarea></label>
    </div>
    <div class="card">
      <h3>Trang chủ</h3>
      <p class="muted">Logo, favicon và banner trang chủ: chỉnh tại <a href="/admin/branding"><b>Logo &amp; Banner</b></a>.</p>
      <label>Video YouTube trang chủ (link, để trống để ẩn)<input name="video_url" value="<%= settings.video_url %>"></label>
    </div>
    <div class="card">
      <h3>SEO trang chủ</h3>
      <label>Địa chỉ website chính
        <small>Ví dụ https://tranhcuongluc.vn — dùng cho thẻ canonical, sitemap.xml, chia sẻ Facebook. Để trống = lấy theo tên miền đang truy cập.</small>
        <input name="site_url" value="<%= settings.site_url %>" placeholder="https://tenmiencuaban.vn"></label>
      <label>Meta title<small>Nên dưới 60 ký tự, có từ khóa chính</small><input name="meta_title" value="<%= settings.meta_title %>" maxlength="70"></label>
      <label>Meta description<small>Nên 120–160 ký tự, mô tả hấp dẫn để khách bấm vào từ Google</small><textarea name="meta_desc" rows="2" maxlength="200"><%= settings.meta_desc %></textarea></label>
    </div>
  </div>
  <div class="col-side">
    <div class="card">
      <button class="btn full"><%- icon('check') %>Lưu cài đặt</button>
    </div>
    <div class="card">
      <h3>Mạng xã hội</h3>
      <label>Facebook<input name="facebook" value="<%= settings.facebook %>"></label>
      <label>Instagram<input name="instagram" value="<%= settings.instagram %>"></label>
      <label>YouTube<input name="youtube" value="<%= settings.youtube %>"></label>
    </div>
  </div>
</form>
<%- include('_foot') %>
