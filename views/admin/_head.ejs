<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title><%= title %> - Quản trị</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap">
<link rel="stylesheet" href="<%= asset('/css/admin.css') %>">
<% if (settings.favicon) { %><link rel="icon" href="<%= settings.favicon %>"><% } %>
</head>
<body>
<%
  const _initials = String(settings.site_name || 'Admin').trim().split(/\s+/).slice(0, 2).map(function (w) { return w[0]; }).join('').toUpperCase();
  const _nav = function (href, ic, label, match, badge) {
    const on = match === '' ? currentPath === '/' : currentPath.startsWith(match);
    return '<a class="nav-link' + (on ? ' active' : '') + '" href="' + href + '"' + (on ? ' aria-current="page"' : '') + '>' + icon(ic) + '<span>' + label + '</span>'
      + (badge ? '<span class="nav-badge" title="' + badge + ' mục mới">' + (badge > 99 ? '99+' : badge) + '</span>' : '') + '</a>';
  };
%>
<aside class="sidebar" id="sidebar">
  <a class="brand" href="/admin"><span class="brand-mark"><%= _initials %></span><span><b><%= settings.site_name %></b><small>Trang quản trị</small></span></a>
  <nav aria-label="Menu quản trị">
    <div class="nav-group">Bán hàng</div>
    <% if (isAdmin) { %><%- _nav('/admin', 'dashboard', 'Tổng quan', '') %><% } %>
    <%- _nav('/admin/orders', 'bag', 'Đơn hàng', '/orders', navCount.orders) %>
    <% if (isAdmin) { %>
    <%- _nav('/admin/leads', 'gift', 'Đăng ký ưu đãi', '/leads', navCount.leads) %>
    <div class="nav-group">Sản phẩm</div>
    <%- _nav('/admin/products', 'image', 'Sản phẩm', '/products') %>
    <%- _nav('/admin/categories', 'folder', 'Danh mục', '/categories') %>
    <div class="nav-group">Nội dung</div>
    <%- _nav('/admin/pages', 'file', 'Trang nội dung', '/pages') %>
    <%- _nav('/admin/reviews', 'star', 'Đánh giá khách hàng', '/reviews') %>
    <%- _nav('/admin/gallery', 'camera', 'Gallery ảnh khách', '/gallery') %>
    <%- _nav('/admin/contact-buttons', 'phone', 'Nút liên hệ', '/contact-buttons') %>
    <%- _nav('/admin/branding', 'palette', 'Logo & Banner', '/branding') %>
    <div class="nav-group">Hệ thống</div>
    <%- _nav('/admin/settings', 'sliders', 'Cài đặt website', '/settings') %>
    <%- _nav('/admin/mail', 'mail', 'Cấu hình email', '/mail') %>
    <%- _nav('/admin/code', 'code', 'Mã Header / Footer', '/code') %>
    <%- _nav('/admin/users', 'users', 'Người dùng', '/users') %>
    <% } %>
  </nav>
  <div class="side-foot">
    <div class="user-chip">
      <a href="/admin/account" class="avatar" title="Tài khoản"><%= (user.name || user.username).trim()[0] %></a>
      <a href="/admin/account" style="min-width:0"><b><%= user.name || user.username %></b><small>@<%= user.username %> · <%= isAdmin ? 'Toàn quyền' : 'Chỉ xem đơn' %></small></a>
      <a class="logout" href="/admin/logout" title="Đăng xuất" aria-label="Đăng xuất"><%- icon('logout') %></a>
    </div>
  </div>
</aside>
<div class="scrim" id="scrim"></div>
<div class="main">
  <header class="topbar">
    <button class="menu-btn" id="menuBtn" aria-label="Mở menu" aria-controls="sidebar" aria-expanded="false"><%- icon('menu') %></button>
    <h1><%= title %></h1>
    <span class="spacer"></span>
    <a class="top-link" href="/" target="_blank" rel="noopener"><%- icon('external') %><span>Xem website</span></a>
  </header>
  <div class="content">
  <% if (flash) { %><div class="alert alert-<%= flash.type %> fade"><%- icon(flash.type === 'success' ? 'check' : 'alert') %><span><%= flash.msg %></span></div><% } %>
