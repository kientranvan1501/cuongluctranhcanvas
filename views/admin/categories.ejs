<%- include('_head') %>
<div class="card">
  <div class="card-head"><p class="muted">Danh mục cấp 1 hiện trên menu chính; cấp 2–3 hiện trong menu xổ xuống.</p><a class="btn btn-sm" href="/admin/categories/new">+ Thêm danh mục</a></div>
  <div class="table-wrap">
  <table class="table">
    <thead><tr><th>Ảnh</th><th>Tên</th><th>Slug</th><th>Thứ tự</th><th>Trang chủ</th><th>SP</th><th></th></tr></thead>
    <tbody>
      <% cats.forEach(function(c){ %>
        <tr>
          <td><% if (c.image) { %><img class="thumb" src="<%= c.image %>" alt=""><% } %></td>
          <td style="padding-left:<%= 12 + c.depth*24 %>px"><%= c.depth ? '└ ' : '' %><a href="/admin/categories/<%= c.id %>/edit"><strong><%= c.name %></strong></a></td>
          <td class="muted"><%= c.slug %></td>
          <td><%= c.sort_order %></td>
          <td><%= c.show_home ? '✅' : '' %></td>
          <td><%= counts[c.id] || 0 %></td>
          <td class="actions">
            <a class="btn btn-sm btn-gray" href="/admin/categories/<%= c.id %>/edit">Sửa</a>
            <form method="post" action="/admin/categories/<%= c.id %>/delete" data-confirm="Xóa danh mục '<%= c.name %>'?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-sm btn-danger">Xóa</button></form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  </div>
</div>
<%- include('_foot') %>
