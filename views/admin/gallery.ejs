<%- include('_head') %>
<div class="card">
  <div class="card-head" style="margin-bottom:6px"><h2 style="margin:0">Tải ảnh lên</h2><a class="btn btn-sm btn-gray" href="/gallery" target="_blank" rel="noopener"><%- icon('external') %>Xem trang Gallery</a></div>
  <p class="muted small" style="margin:0 0 14px">Ảnh feedback khách gửi về (ảnh tranh đã treo, ảnh chụp màn hình tin nhắn…). Chọn được nhiều ảnh một lúc, ảnh tự thu nhỏ cho nhẹ trước khi tải lên. Nhận JPG, PNG, WEBP.</p>
  <form method="post" action="/admin/gallery/upload" enctype="multipart/form-data" id="glForm">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label class="gl-drop" id="glDrop">
      <%- icon('upload') %>
      <b>Bấm để chọn ảnh hoặc kéo thả ảnh vào đây</b>
      <small>Có thể chọn cùng lúc nhiều ảnh</small>
      <input type="file" name="upload" id="glFiles" accept="image/jpeg,image/png,image/webp" multiple>
    </label>
    <div class="gl-queue" id="glQueue" hidden></div>
    <div class="gl-actions" id="glActions" hidden>
      <button class="btn" id="glSend"><%- icon('upload') %><span>Tải lên</span></button>
      <button type="button" class="btn btn-gray" id="glClear">Bỏ chọn</button>
      <span class="muted small" id="glStatus"></span>
    </div>
  </form>
</div>

<form method="post" action="/admin/gallery" class="card" id="glList">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <%# Nút mặc định khi nhấn Enter trong ô chú thích = Lưu thay đổi (không phải "Hiện ảnh đã chọn") %>
  <button name="action" value="save" tabindex="-1" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px"></button>
  <div class="card-head">
    <h2><%= photos.length %> ảnh <span class="muted small" style="font-weight:400">· <%= photos.filter(function (p) { return p.active; }).length %> đang hiện trên web</span></h2>
    <% if (photos.length) { %>
    <div class="gl-tools">
      <label class="check" style="margin:0"><input type="checkbox" id="glAll"> Chọn tất cả</label>
      <button class="btn btn-sm btn-gray" name="action" value="show">Hiện ảnh đã chọn</button>
      <button class="btn btn-sm btn-gray" name="action" value="hide">Ẩn ảnh đã chọn</button>
      <button class="btn btn-sm btn-danger" name="action" value="delete" data-ask="Xóa các ảnh đã chọn? Không khôi phục được.">Xóa ảnh đã chọn</button>
      <button class="btn btn-sm" name="action" value="save"><%- icon('check') %>Lưu thay đổi</button>
    </div>
    <% } %>
  </div>
  <% if (!photos.length) { %>
    <div class="empty"><%- icon('camera') %>Chưa có ảnh nào. Tải ảnh feedback của khách ở khung phía trên.</div>
  <% } else { %>
  <p class="muted small" style="margin:-6px 0 14px">Ảnh có <b>thứ tự</b> nhỏ hơn hiện trước (ảnh mới tải luôn nằm đầu). Sửa chú thích / thứ tự / ẩn hiện xong bấm <b>Lưu thay đổi</b>.</p>
  <div class="gl-grid">
    <% photos.forEach(function (p) { %>
      <div class="gl-item<%= p.active ? '' : ' off' %>">
        <label class="gl-sel"><input type="checkbox" name="sel" value="<%= p.id %>" aria-label="Chọn ảnh"></label>
        <a href="<%= p.image %>" target="_blank" rel="noopener" class="gl-img"><img src="<%= p.thumb || p.image %>" alt="" loading="lazy"></a>
        <div class="gl-meta">
          <input name="cap[id<%= p.id %>]" value="<%= p.caption %>" maxlength="200" placeholder="Chú thích (không bắt buộc)">
          <div class="gl-row">
            <label title="Thứ tự">#<input type="number" name="sort[id<%= p.id %>]" value="<%= p.sort_order %>"></label>
            <label class="check"><input type="checkbox" name="act[id<%= p.id %>]" <%= p.active ? 'checked' : '' %>> Hiện</label>
            <button class="btn btn-sm btn-ghost danger" name="del" value="<%= p.id %>" data-ask="Xóa ảnh này?" title="Xóa ảnh" aria-label="Xóa ảnh"><%- icon('trash') %></button>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
  <% } %>
</form>

<script>
(function () {
  // ---- Danh sách: chọn tất cả + hỏi lại trước khi xóa
  var list = document.getElementById('glList'), all = document.getElementById('glAll');
  all && all.addEventListener('change', function () { list.querySelectorAll('input[name="sel"]').forEach(function (c) { c.checked = all.checked; }); });
  list.addEventListener('submit', function (e) { var b = e.submitter; if (b && b.dataset.ask && !confirm(b.dataset.ask)) e.preventDefault(); });

  // ---- Tải lên: xem trước, thu nhỏ ảnh ngay trên trình duyệt rồi gửi
  var form = document.getElementById('glForm'), input = document.getElementById('glFiles'), drop = document.getElementById('glDrop');
  var queue = document.getElementById('glQueue'), actions = document.getElementById('glActions'), status = document.getElementById('glStatus');
  var sendBtn = document.getElementById('glSend'), files = [];
  function show() {
    queue.innerHTML = '';
    files.forEach(function (f, i) {
      var d = document.createElement('div'); d.className = 'gl-q';
      d.innerHTML = '<img alt=""><input placeholder="Chú thích (không bắt buộc)" maxlength="200"><button type="button" class="gl-x" aria-label="Bỏ ảnh này">×</button>';
      d.querySelector('img').src = URL.createObjectURL(f);
      d.querySelector('input').value = f._cap || '';
      d.querySelector('input').addEventListener('input', function (e) { f._cap = e.target.value; });
      d.querySelector('.gl-x').addEventListener('click', function () { files.splice(i, 1); show(); });
      queue.appendChild(d);
    });
    queue.hidden = actions.hidden = !files.length;
    sendBtn.querySelector('span').textContent = 'Tải lên ' + files.length + ' ảnh';
    status.textContent = '';
  }
  function add(list) {
    Array.prototype.forEach.call(list, function (f) { if (/^image\/(jpeg|png|webp)$/.test(f.type)) files.push(f); });
    input.value = ''; show();
  }
  input.addEventListener('change', function () { add(input.files); });
  ['dragenter', 'dragover'].forEach(function (t) { drop.addEventListener(t, function (e) { e.preventDefault(); drop.classList.add('over'); }); });
  ['dragleave', 'drop'].forEach(function (t) { drop.addEventListener(t, function (e) { e.preventDefault(); drop.classList.remove('over'); }); });
  drop.addEventListener('drop', function (e) { add(e.dataTransfer.files); });
  document.getElementById('glClear').addEventListener('click', function () { files = []; show(); });

  // Thu nhỏ ảnh: cạnh dài tối đa max px, xuất JPEG (giữ nét, file nhẹ hơn nhiều so với ảnh gốc từ điện thoại)
  function resize(file, max, q) {
    return new Promise(function (ok, fail) {
      var img = new Image();
      img.onload = function () {
        var s = Math.min(1, max / Math.max(img.naturalWidth, img.naturalHeight));
        var c = document.createElement('canvas');
        c.width = Math.round(img.naturalWidth * s); c.height = Math.round(img.naturalHeight * s);
        var x = c.getContext('2d'); x.fillStyle = '#fff'; x.fillRect(0, 0, c.width, c.height); // PNG trong suốt -> nền trắng
        x.imageSmoothingQuality = 'high'; x.drawImage(img, 0, 0, c.width, c.height);
        c.toBlob(function (b) { b ? ok({ blob: b, w: c.width, h: c.height }) : fail(new Error('toBlob')); }, 'image/jpeg', q);
      };
      img.onerror = function () { fail(new Error('Không đọc được ảnh ' + file.name)); };
      img.src = URL.createObjectURL(file);
    });
  }
  form.addEventListener('submit', function (e) {
    if (!files.length) return e.preventDefault();
    if (!window.fetch || !HTMLCanvasElement.prototype.toBlob) { // trình duyệt quá cũ: gửi ảnh gốc
      var dt = new DataTransfer(); files.forEach(function (f) { dt.items.add(f); }); input.files = dt.files; return;
    }
    e.preventDefault();
    sendBtn.disabled = true;
    var fd = new FormData(); fd.append('_csrf', form._csrf.value);
    var done = 0, chain = Promise.resolve();
    files.forEach(function (f) {
      chain = chain.then(function () {
        status.textContent = 'Đang xử lý ảnh ' + (++done) + '/' + files.length + '…';
        return Promise.all([resize(f, 2000, 0.9), resize(f, 700, 0.85)]).then(function (r) {
          var base = f.name.replace(/\.[^.]+$/, '').replace(/[^\w-]+/g, '-').slice(0, 40) || 'anh';
          fd.append('w', r[0].w); fd.append('h', r[0].h); fd.append('caption', f._cap || '');
          fd.append('full', r[0].blob, base + '.jpg'); fd.append('thumb', r[1].blob, base + '-sm.jpg');
        });
      });
    });
    chain.then(function () {
      status.textContent = 'Đang tải lên…';
      return fetch(form.action, { method: 'POST', body: fd, headers: { 'X-Requested-With': 'fetch' }, credentials: 'same-origin' });
    }).then(function (r) {
      return r.text().then(function (t) { var j; try { j = JSON.parse(t); } catch (x) { throw new Error(t.slice(0, 200) || ('Lỗi ' + r.status)); } if (!j.ok && j.error) throw new Error(j.error); return j; });
    }).then(function () { location.reload(); })
      .catch(function (err) { status.textContent = '⚠ ' + err.message; sendBtn.disabled = false; });
  });
})();
</script>
<%- include('_foot') %>
