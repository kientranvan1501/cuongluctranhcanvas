<%- include('_head') %>
<div class="card">
  <div class="card-head"><p class="muted">Tài khoản <b>Chỉ xem đơn hàng</b> chỉ thấy mục Đơn hàng: xem danh sách và chi tiết, không sửa / xóa được.</p><a class="btn btn-sm" href="/admin/users/new">+ Thêm người dùng</a></div>
  <div class="table-wrap">
  <table class="table">
    <thead><tr><th>Tên đăng nhập</th><th>Họ tên</th><th>Quyền</th><th>Trạng thái</th><th>Ngày tạo</th><th></th></tr></thead>
    <tbody>
      <% users.forEach(function(u){ %>
        <tr>
          <td><a href="/admin/users/<%= u.id %>/edit"><%= u.username %></a><% if (u.id === user.id) { %> <span class="muted">(bạn)</span><% } %></td>
          <td><%= u.name %></td>
          <td><%= ROLES[u.role] || u.role %></td>
          <td><%= u.active ? 'Hoạt động' : 'Đã khóa' %></td>
          <td><%= u.created_at %></td>
          <td class="actions">
            <a class="btn btn-sm btn-gray" href="/admin/users/<%= u.id %>/edit">Sửa</a>
            <% if (u.id !== user.id) { %><form method="post" action="/admin/users/<%= u.id %>/delete" data-confirm="Xóa người dùng <%= u.username %>?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-sm btn-danger">Xóa</button></form><% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  </div>
</div>
<%- include('_foot') %>
